FROM node:20-alpine

# Install dependencies
RUN apk add --no-cache \
    git \
    curl \
    bash

# Set working directory
WORKDIR /var/www/html

# Copy package files
COPY package*.json ./
COPY vite.config.js ./

# Install dependencies
RUN npm ci --no-audit --prefer-offline

# Copy application files
COPY . .

# Expose Vite port
EXPOSE 5173

# Default command
CMD ["npm", "run", "dev", "--", "--host"]